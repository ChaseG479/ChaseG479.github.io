#HT on Proportions
prop.test(
4,                   #value of x
200,                 #value of n
p=0.05,              #hypothesized p
alternative="less",  #"two.sided", "less", "greater"
conf.level=0.95,     #1-alpha
correct = FALSE      #don't use any adjustments to the approximation
)
#HT on Proportions
prop.test(
7,                   #value of x
300,                 #value of n
p=0.02,              #hypothesized p
alternative="less",  #"two.sided", "less", "greater"
conf.level=0.95,     #1-alpha
correct = FALSE      #don't use any adjustments to the approximation
)
#HT on Proportions
prop.test(
7,                   #value of x
300,                 #value of n
p=0.02,              #hypothesized p
alternative="greater",  #"two.sided", "less", "greater"
conf.level=0.95,     #1-alpha
correct = FALSE      #don't use any adjustments to the approximation
)
#HT on Proportions
prop.test(
7,                   #value of x
300,                 #value of n
p=0.02,              #hypothesized p
alternative="greater",  #"two.sided", "less", "greater"
conf.level=0.95,     #1-alpha
correct = TRUE      #don't use any adjustments to the approximation
)
#HT on Proportions
prop.test(
7,                   #value of x
300,                 #value of n
p=0.02,              #hypothesized p
alternative="greater",  #"two.sided", "less", "greater"
conf.level=0.95,     #1-alpha
correct = FALSE      #don't use any adjustments to the approximation
)
# load packages
pacman::p_load(goftest, magrittr, rio, tidyverse)
